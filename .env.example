# ─── Copy to .env and fill in. Never commit .env. ───

# ── Execution ──────────────────────────────────────────────
# alert    = emit an order ticket only, no browser
# assisted = pre-fill the ThndrX ticket, stop before confirm, wait for your approval
# auto     = confirm without a human (requires EGX_I_UNDERSTAND_LIVE_TRADING=true)
EGX_EXECUTION_MODE=alert

# Second gate for auto mode. Both this and EXECUTION_MODE=auto are required.
EGX_I_UNDERSTAND_LIVE_TRADING=false

# Hard ceiling on any single order, in EGP. Applies in every mode.
EGX_MAX_ORDER_EGP=10000

# Ticket expires if unconfirmed for this long. Expiry never means "execute".
EGX_CONFIRM_TIMEOUT_SECONDS=600

# ── Universe ───────────────────────────────────────────────
# sharia = Thndr-labelled Sharia-compliant names only
# all    = every tradable EGX name
EGX_UNIVERSE_MODE=sharia

# ── Market data ────────────────────────────────────────────
# Ordered, comma-separated. First provider with a bar for a date wins; later ones
# only fill gaps. `yahoo,eodhd` = "Yahoo, with its 22-30% session gaps patched".
#   yahoo            free, automatable, loses 22-30% of EGX sessions at random
#   eodhd            $19.99/mo, API-native, EGX coverage unverified
#   tradingview_csv  $28.29/mo Plus. Manual export only — TradingView has NO data
#                    API at any tier and its ToS forbids automated collection.
# Verify before paying: `egx compare-providers`
EGX_DATA_PROVIDERS=yahoo

# The Cloudflare Worker that fetches Yahoo from CF edge egress (Render/local IPs get 429'd).
EGX_YAHOO_BASE_URL=https://<your-worker>.workers.dev
# Shared secret for the Worker. Never commit the real value anywhere.
EGX_PROXY_KEY=

# EODHD. EGX needs a paid plan; the demo token only covers a few US symbols.
EGX_EODHD_API_KEY=

# Where to drop TradingView "Export chart data" CSVs (three dots -> Export, Plus/Premium).
EGX_TV_CSV_DIR=./data/tradingview

# ── Notifications ──────────────────────────────────────────
# Telegram is the primary confirm channel (inline buttons, long-polling — no webhook/hosting).
EGX_TELEGRAM_TOKEN=
EGX_TELEGRAM_CHAT_ID=

# Email carries the daily report and an audit copy of tickets. Not the channel to act on.
EGX_NOTIFY_EMAIL=you@example.com
EGX_SMTP_HOST=smtp.gmail.com
EGX_SMTP_PORT=587
EGX_SMTP_USER=
EGX_SMTP_PASSWORD=

EGX_MACOS_NOTIFICATIONS=true

# ── Broker (Thndr) ─────────────────────────────────────────
# Thndr Trader subscription: 50 commission-free trades/month, then 2 EGP + 0.1%.
EGX_FREE_TRADES_PER_MONTH=50
EGX_THNDRX_URL=https://x.thndr.app/workspaces/default/home

# ── Risk ───────────────────────────────────────────────────
EGX_MAX_POSITION_PCT=25.0
EGX_MAX_SECTOR_PCT=40.0
EGX_MAX_NEW_POSITIONS_PER_DAY=3
EGX_DAILY_LOSS_LIMIT_PCT=4.0
# Existing positions predate the bot. true = don't force them down to MAX_POSITION_PCT.
EGX_GRANDFATHER_EXISTING=true

# ── Storage ────────────────────────────────────────────────
EGX_DATA_DIR=./data
EGX_LOG_LEVEL=INFO
